{
  "name": "@withwiz/blog-system",
  "version": "0.3.0",
  "packageManager": "pnpm@11.24.0",
  "description": "Blog SaaS framework — single/multi-tenant, auth, billing, domain management",
  "license": "MIT",
  "private": false,
  "files": [
    "dist"
  ],
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*"
      ]
    }
  },
  "exports": {
    ".": "./dist/index.js",
    "./core": "./dist/core/index.js",
    "./auth": "./dist/auth/index.js",
    "./routes": "./dist/routes/index.js",
    "./tenant": "./dist/tenant/index.js",
    "./admin": "./dist/admin/index.js",
    "./onboarding": "./dist/onboarding/index.js",
    "./validators": "./dist/validators/index.js",
    "./types": "./dist/types/index.js",
    "./billing": "./dist/billing/index.js",
    "./styles/admin": "./dist/styles/blog-system-admin.css"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --skipLibCheck",
    "build:js": "tsup",
    "build:types": "tsc --emitDeclarationOnly --skipLibCheck",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@withwiz/blog-core": "^2.1.5",
    "stripe": "^17"
  },
  "peerDependencies": {
    "@prisma/client": ">=5",
    "@withwiz/toolkit": ">=0.11.0",
    "next": ">=15",
    "react": ">=18",
    "zod": ">=3"
  },
  "devDependencies": {
    "@prisma/client": "^7.10.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@withwiz/toolkit": "^0.15.0",
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0",
    "vitest": "^3.2.7",
    "zod": "^4.6.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeun/withwiz-blog-system.git"
  },
  "homepage": "https://github.com/greeun/withwiz-blog-system#readme",
  "bugs": {
    "url": "https://github.com/greeun/withwiz-blog-system/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
